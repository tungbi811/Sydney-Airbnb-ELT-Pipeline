# Copy this file to airflow/.env and run Docker Compose from airflow/.
AIRFLOW_UID=50000
# Generate a Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate each secret separately: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW__API__SECRET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
